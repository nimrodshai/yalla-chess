# Copy to .env and fill in. The server reads plain environment variables, so
# load this with your process manager (systemd EnvironmentFile, `docker run
# --env-file`, or `set -a; . ./.env; set +a`).

# ---------------------------------------------------------------- required
NODE_ENV=production

# Public https origin of the site. Required in production: session cookies are
# marked Secure based on it, and it is the default allowed CORS origin.
PUBLIC_ORIGIN=https://yalla-chess.example

# Bind address. 0.0.0.0 inside a container, 127.0.0.1 behind a local proxy.
HOST=127.0.0.1
PORT=8001

# Set when a reverse proxy sets X-Forwarded-For, so per-IP rate limits see the
# real client. Leave false if nothing trustworthy sets that header, otherwise
# a client can spoof its address.
TRUST_PROXY=true

# ------------------------------------------------------ SMS (Twilio Verify)
# Required in production; the server refuses to boot without them. Prefer an
# API key over the account auth token.
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=
# ...or, instead of the API key pair:
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=

# --------------------------------------------------------- email (Resend)
# Used to notify about contact-form submissions. Optional: without it requests
# are still stored, just not emailed.
RESEND_API_KEY=
RESEND_FROM=Yalla-Chess <noreply@yalla-chess.example>
CONTACT_NOTIFY_TO=dolev@example.com

# ------------------------------------------------------------------ data
# Where the SQLite database lives. Point at a persistent volume.
DATA_DIR=/var/lib/yalla-chess
DB_FILE=yalla-chess.db

# Creates the first teacher account when the database is empty. Remove after
# the first successful boot.
BOOTSTRAP_TEACHER_PHONE=+972500000000

# ------------------------------------------- replication (Docker image only)
# When DATA_DIR is not a persistent volume (Render free tier), the container
# restores the database from an S3-compatible bucket at boot and streams every
# write back with Litestream. Leave LITESTREAM_BUCKET empty to disable. The key
# needs read, write, list and delete on this one bucket.
# LITESTREAM_BUCKET=yalla-chess-db
# LITESTREAM_ENDPOINT=s3.eu-central-003.backblazeb2.com
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
# Object prefix inside the bucket, defaults to the database file name.
# LITESTREAM_PATH=yalla-chess.db
# Set automatically by the entrypoint when replicating; `truncate` otherwise.
# DB_CLOSE_CHECKPOINT=passive

# ------------------------------------------------------------- optional
# LOG_LEVEL=info
# SESSION_TTL_DAYS=180
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# Extra browser origins allowed to call the API, comma separated. Only needed
# if the front end is served from somewhere other than PUBLIC_ORIGIN.
# ALLOWED_ORIGINS=
# RATE_LIMIT_LOGIN_PER_PHONE=5
# RATE_LIMIT_LOGIN_PER_IP=20

# ------------------------------------------- development only, never in prod
# Both are ignored when NODE_ENV=production.
# TWILIO_ALLOW_CONSOLE_FALLBACK=true   # print OTP codes instead of texting
# ENABLE_DEBUG_ENDPOINTS=true          # expose /api/debug/*
